# API Provider: huggingface | zai
API_PROVIDER=huggingface

# HuggingFace Router API
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# ZAI API (GLM modelleri)
NEW_KEY=your_zai_api_key_here
SECOND_API_KEY=your_second_zai_api_key_here
ZAI_MODEL=glm-4.6v-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Ortak model adı (sağlayıcıya özel MODEL yoksa kullanılır)
MODEL_NAME=zai-org/GLM-4.6V-Flash
MODEL_NAME_2=zai-org/GLM-4.6V-Flash
