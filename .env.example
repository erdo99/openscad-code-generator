# API Keys
# Bu dosyayı .env olarak kopyalayın ve API key'lerinizi ekleyin

# HuggingFace Token (Opsiyonel)
HF_TOKEN=your_huggingface_token_here

# ZAI API Keys
NEW_KEY=your_zai_api_key_here
SECOND_API_KEY=your_second_zai_api_key_here

# Model Names
MODEL_NAME=zai-org/GLM-4.6V-Flash
MODEL_NAME_2=zai-org/GLM-4.6V-Flash

# io_net API Key
IO_NET_KEY=your_io_net_api_key_here
IO_NET_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
IO_NET_BASE_URL=https://api.intelligence.io.solutions/api/v1



